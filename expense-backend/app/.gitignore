# ==========================================
build/
dist/
wheels/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ==========================================
# Testing and coverage
# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
test-results/

# ==========================================
# Type checking and linting
# ==========================================
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ==========================================
# Logs and temporary files
# ==========================================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
~*

# ==========================================
# IDEs and code editors
# ==========================================
.vscode/
.idea/
*.iml

# Keep shared VS Code project settings if needed
# !.vscode/extensions.json
# !.vscode/launch.json

# ==========================================
